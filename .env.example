ENVIRONMENT=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

LITELLM_MASTER_KEY=sk-litellm-master
LITELLM_SALT_KEY=sk-litellm-salt
LITELLM_BASE_URL=http://localhost:4000

# Google AI Studio (primary model) - https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Azure OpenAI (fallback tier 1 - paid, reliable, used if Gemini's free-tier quota is hit)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# OpenRouter (fallback tier 2 - free, last resort if Azure is also unavailable)
OPENROUTER_API_KEY=

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
